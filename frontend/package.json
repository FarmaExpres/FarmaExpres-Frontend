{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dev": "vite --mode dev",
    "dev:qa": "vite --mode qa",
    "dev:main": "vite --mode main",
    "docker:up:dev": "docker compose --env-file .env.dev up -d --build",
    "docker:up:qa": "docker compose --env-file .env.qa up -d --build",
    "docker:up:main": "docker compose --env-file .env.main up -d --build",
    "docker:down:dev": "docker compose --env-file .env.dev down",
    "docker:down:qa": "docker compose --env-file .env.qa down",
    "docker:down:main": "docker compose --env-file .env.main down",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "exceljs": "^4.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.1"
  }
}
