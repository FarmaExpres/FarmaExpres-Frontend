# Nombre del proyecto compose para aislar recursos por ambiente
COMPOSE_PROJECT_NAME=farmaexpres-frontend-dev

# Red externa del backend del ambiente correspondiente
BACKEND_NETWORK=farmaexpres-dev_default

# Frontend publicado al host
FRONTEND_PORT=3000

# Nombres opcionales para contenedor e imagen
FRONTEND_CONTAINER_NAME=farmaexpres-frontend-dev
FRONTEND_IMAGE_NAME=farmaexpres-frontend:dev

# URL interna del gateway dentro de la red Docker
BACKEND_URL=http://api-gateway:8080

# Variables para ejecución local con Vite (sin Docker)
VITE_DEV_SERVER_PORT=3000
VITE_PROXY_TARGET=http://localhost:8080
